# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sentry Monitoring (optional - obtener en https://sentry.io)
VITE_SENTRY_DSN=your_sentry_dsn_here

# App Version (con índices acústicos, virtual scrolling y filtros de audio)
VITE_APP_VERSION=2.3.0

# Optional: Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Optional: BirdNET API Key (when available)
VITE_BIRDNET_API_KEY=your_birdnet_api_key_here
